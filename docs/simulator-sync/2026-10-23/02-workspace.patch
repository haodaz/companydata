+    const parts = [j.applied?.length ? `${j.applied.length} 项写进了平方企业库` : '', j.pending?.length ? `${j.pending.length} 项和平方现有记录不同，已提交审核` : ''].filter(Boolean);
+    setMsg(parts.length ? `已保存：${parts.join('，')}。内部信息只留在你的工作台。` : '已保存。'); reload(); then?.();
