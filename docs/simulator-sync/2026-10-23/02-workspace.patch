+  const del = async (id: string) => { await fetch(`/api/ws/roles?id=${id}`, { method: 'DELETE' }); reload(); };
+  return (
+    <>
+      <h1 className="ws-title">{d.kind === 'research' ? '你要招哪些研究岗' : '你要管哪些岗位'}</h1>
