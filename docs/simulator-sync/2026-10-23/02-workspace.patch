+          {a.scan && <><div className="ws-sub">能力扫描 {a.scan.score} {a.scan.grade}</div><div style={{ fontSize: 13.5 }}>{a.scan.headline}</div>{!!a.scan.strengths?.length && <><div className="ws-sub">优势</div><ul className="ws-list">{a.scan.strengths.slice(0, 3).map((x: any, i: number) => <li key={i}>{typeof x === 'string' ? x : x.title || x.text || JSON.stringify(x)}</li>)}</ul></>}{!!a.scan.risks?.length && <><div className="ws-sub">风险</div><ul className="ws-list">{a.scan.risks.slice(0, 3).map((x: any, i: number) => <li key={i}>{typeof x === 'string' ? x : x.title || x.text || JSON.stringify(x)}</li>)}</ul></>}{!!a.mismatches?.length && <><div className="ws-sub">存疑项</div><ul className="ws-list">{a.mismatches.map((m: any, i: number) => <li key={i}>{typeof m === 'string' ? m : `${m.claim}${m.note ? `：${m.note}` : ''}`}</li>)}</ul></>}</>}
