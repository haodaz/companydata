+      <div style={{ display: 'flex', gap: 10, marginTop: 16 }}>
+        <button className="ws-primary" disabled={!!busy} onClick={() => save(embedded ? undefined : next)}>{embedded ? '保存' : '保存，下一步：岗位'}</button>
