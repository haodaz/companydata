diff --git a/extension/zhenhuo/linkedin.js b/extension/zhenhuo/linkedin.js
new file mode 100644
index 0000000..f607dd8
--- /dev/null
+++ b/extension/zhenhuo/linkedin.js
@@ -0,0 +1,67 @@
+// 读本人 LinkedIn（2026-10-23 探索）：只开 linkedin.com/in/me/——LinkedIn 会跳到当前登录账号自己的主页，所以只能交本人的。
+// 只读中间栏的名片、简介，再读经历 / 教育 / 技能等详情页；右栏「看过的人也看了」「你可能认识的人」这些别人的信息不读。读完关掉标签页。
+const LI = 'https://www.linkedin.com';
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+const DETAILS = [['experience', '工作经历'], ['education', '教育经历'], ['skills', '技能'], ['certifications', '资质认证'], ['projects', '项目'], ['languages', '语言'], ['honors', '荣誉奖项'], ['publications', '出版物']];
+
+function waitLoaded(tabId, ms = 25000) {
+  return new Promise(res => {
+    const done = () => { chrome.tabs.onUpdated.removeListener(f); clearTimeout(t); res(); };
+    const f = (id, info) => { if (id === tabId && info.status === 'complete') done(); };
+    const t = setTimeout(done, ms);
+    chrome.tabs.onUpdated.addListener(f);
+  });
+}
+
+// 注入页面跑：滚到底让懒加载的版块出来，按 h2 标题挑版块
+async function readProfile() {
+  for (let i = 0; i < 10; i++) { window.scrollBy(0, 900); await new Promise(r => setTimeout(r, 400)); }
+  window.scrollTo(0, 0);
+  const main = document.querySelector('main'); if (!main) return null;
+  const SELF = /^(Enhance with AI|Show recruiters|Share that you|Showcase your services|Tell non-profits|Get started|Add section|Enhance profile|Open to$|Add services|Verify|Contact info|\d+\s+connections|向招聘方|开始使用|添加版块|完善个人档案|联系方式)/i;
+  const clean = t => t.split('\n').map(l => l.trim()).filter(l => l && !SELF.test(l)).join('\n');
+  const hs = [...main.querySelectorAll('h2')];
+  const out = {};
+  hs.forEach((h, i) => {
+    const name = (h.innerText || '').trim().split('\n')[0]; const s = h.closest('section'); if (!s) return;
+    if (i === 0) out.card = clean(s.innerText);
+    else if (/^(About|关于|简介)$/i.test(name)) out.about = clean(s.innerText.replace(/^(About|关于|简介)\s*/i, ''));
+  });
+  return out;
+}
+async function readDetail() {
+  for (let i = 0; i < 8; i++) { window.scrollBy(0, 1000); await new Promise(r => setTimeout(r, 400)); }
+  if (!/\/details\//.test(location.pathname)) return '';   // 没有这个版块时 LinkedIn 会跳回主页
+  const SELF = /^(Enhance with AI|Show all|Edit|Add|添加|编辑|用 AI 完善)$/i;   // 只给本人看的按钮文字
+  const s = document.querySelector('main section'); const t = (s?.innerText || '').split('\n').map(l => l.trim()).filter(l => l && !SELF.test(l)).join('\n');
+  return /Nothing to see|暂无内容/i.test(t) ? '' : t;
+}
+
+async function readLinkedIn() {
+  const tab = await chrome.tabs.create({ url: `${LI}/in/me/`, active: true });
+  try {
+    await waitLoaded(tab.id); await sleep(2500);
+    const cur = await chrome.tabs.get(tab.id);
+    const u = new URL(cur.url);
+    if (/\/(login|authwall|checkpoint|signup|uas)/.test(u.pathname) || u.hostname !== 'www.linkedin.com') return { ok: false, error: '这个浏览器还没登录 LinkedIn：先登录你自己的账号，再点一次' };
+    const m = u.pathname.match(/^\/in\/([^/]+)\/?/);
+    if (!m || m[1] === 'me') return { ok: false, error: '没跳到你的主页，稍后再试一次' };
+    const slug = decodeURIComponent(m[1]);
+    const [p] = await chrome.scripting.executeScript({ target: { tabId: tab.id }, func: readProfile });
+    const sections = [];
+    if (p?.result?.card) sections.push({ key: 'card', label: '名片', text: p.result.card });
+    if (p?.result?.about) sections.push({ key: 'about', label: '简介', text: p.result.about });
+    for (const [key, label] of DETAILS) {
+      await chrome.tabs.update(tab.id, { url: `${LI}/in/${encodeURIComponent(slug)}/details/${key}/` });
+      await waitLoaded(tab.id); await sleep(1800);
+      const [d] = await chrome.scripting.executeScript({ target: { tabId: tab.id }, func: readDetail }).catch(() => [null]);
+      const text = d?.result || '';
+      if (text.length > 20) sections.push({ key, label, text: text.slice(0, 12000) });
+    }
+    return { ok: true, slug, url: `${LI}/in/${slug}/`, sections, read_at: new Date().toISOString() };
+  } catch (e) {
+    return { ok: false, error: '读取中断：' + String(e?.message || e).slice(0, 120) };
+  } finally {
+    chrome.tabs.remove(tab.id).catch(() => {});
+  }
+}
diff --git a/extension/zhenhuo/manifest.json b/extension/zhenhuo/manifest.json
new file mode 100644
index 0000000..3dc893d
--- /dev/null
+++ b/extension/zhenhuo/manifest.json
@@ -0,0 +1,16 @@
+{
+  "manifest_version": 3,
+  "name": "真活插件",
+  "version": "0.2.0",
+  "description": "百业AI｜真活：用自己的工具答题时，只在答题期间记录打开的网页、页面上的文字（含 AI 对话）和打字粘贴的量，交卷后由 AI 回看过程。",
+  "permissions": ["sidePanel", "scripting", "storage", "tabs", "alarms", "notifications"],
+  "host_permissions": ["<all_urls>"],
+  "background": { "service_worker": "background.js" },
+  "side_panel": { "default_path": "sidepanel.html" },
+  "action": { "default_title": "打开真活插件", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
+  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
+  "content_scripts": [
+    { "matches": ["https://www.aidataoffice.com/*", "https://aidataoffice.com/*", "http://localhost:3003/*"], "js": ["bridge.js"], "run_at": "document_idle" },
+    { "matches": ["<all_urls>"], "js": ["counter.js"], "run_at": "document_idle" }
+  ]
+}
diff --git a/extension/zhenhuo/sidepanel.css b/extension/zhenhuo/sidepanel.css
new file mode 100644
index 0000000..827071d
--- /dev/null
+++ b/extension/zhenhuo/sidepanel.css
@@ -0,0 +1,29 @@
+* { box-sizing: border-box; }
+body { margin: 0; font: 14px/1.6 -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; color: #1a1a2e; background: #f6f7fb; }
+header { display: flex; gap: 10px; align-items: center; padding: 12px 14px; background: #fff; border-bottom: 1px solid #e8e9f0; }
+header img { width: 30px; height: 30px; border-radius: 8px; }
+header b { display: block; font-size: 15px; } header small { color: #888; font-size: 12px; }
+main { padding: 14px; display: grid; gap: 12px; }
+.card { background: #fff; border: 1px solid #e8e9f0; border-radius: 12px; padding: 12px 14px; }
+.k { font-size: 12px; color: #6055f5; font-weight: 700; letter-spacing: 1px; margin-bottom: 4px; }
+.title { font-weight: 700; font-size: 15px; line-height: 1.45; }
+.muted { color: #888; font-size: 12.5px; }
+.clock { font: 800 40px/1 ui-monospace, Menlo, monospace; letter-spacing: 1px; text-align: center; padding: 6px 0 2px; }
+.clock.warn { color: #d46b08; } .clock.hot { color: #cf1322; }
+.rec { display: flex; align-items: center; gap: 8px; font-weight: 700; color: #cf1322; }
+.rec i { width: 10px; height: 10px; border-radius: 50%; background: #cf1322; animation: blink 1.2s infinite; }
+.rec.off { color: #888; } .rec.off i { background: #bbb; animation: none; }
+@keyframes blink { 50% { opacity: .25; } }
+.stats { display: flex; gap: 14px; font-size: 12.5px; color: #555; margin-top: 6px; } .stats b { color: #1a1a2e; }
+.banner { border-radius: 10px; padding: 10px 12px; font-weight: 700; }
+.banner.w5 { background: #fff7e6; color: #ad4e00; border: 1px solid #ffd591; } .banner.w1 { background: #fff1f0; color: #a8071a; border: 1px solid #ffa39e; }
+textarea, input { width: 100%; border: 1px solid #d9d9e3; border-radius: 8px; padding: 8px 10px; font: inherit; resize: vertical; background: #fff; }
+textarea { min-height: 130px; }
+button { border: 0; border-radius: 10px; padding: 10px 14px; font: inherit; font-weight: 700; cursor: pointer; }
+.primary { background: #6055f5; color: #fff; width: 100%; } .primary:disabled { background: #b8b3f7; cursor: default; }
+.end { background: #cf1322; color: #fff; width: 100%; font-size: 16px; padding: 14px; }
+.ghost { background: #f0f0f7; color: #444; }
+.row { display: flex; gap: 8px; } .row > * { flex: 1; }
+.ok { color: #237a45; } .err { color: #cf1322; font-size: 13px; }
+ul { margin: 4px 0 0; padding-left: 18px; color: #555; font-size: 13px; }
+a { color: #6055f5; }
