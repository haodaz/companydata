+    title: s(p.title, 80) || opts.title || '未命名样本', summary: s(p.summary, 600), problem_type: s(p.problem_type, 40), industry: s(p.industry, 40), difficulty: s(p.difficulty, 10) || '中', format: s(p.format, 30) || 'interviewer-led',
