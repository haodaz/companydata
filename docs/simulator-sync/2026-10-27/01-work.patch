+/** 给出题提示词用：骨架渲染成文字 */
+export function renderSkeleton(k: SampleSkeleton): string {
+  const L = [`标题：${k.title} · 类型：${k.problem_type || '—'} · 行业：${k.industry || '—'} · 难度：${k.difficulty} · 形式：${k.format}`, k.summary ? `概要：${k.summary}` : ''];
