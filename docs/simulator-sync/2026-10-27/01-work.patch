+export async function GET(req: NextRequest) {
+  const user = await getSessionUser(req);
+  if (!user || user.role !== 'admin') return NextResponse.json({ ok: false, error: '需要管理员' }, { status: 403 });
+  const sp = req.nextUrl.searchParams; const q = sp.get('q') || ''; const industry = sp.get('industry') || ''; const fn = sp.get('fn') || ''; const company = sp.get('company_id');
+  let qb = db.from('work_question_bank').select('*').order('updated_at', { ascending: false }).limit(500);
+  if (q) qb = qb.or(`title.ilike.%${q}%,company_name.ilike.%${q}%,role.ilike.%${q}%`);
+  if (industry) qb = qb.eq('industry', industry); if (fn) qb = qb.eq('job_function', fn); if (company) qb = qb.eq('company_id', Number(company));
+  const { data, error } = await qb;
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  const { data: all } = await db.from('work_question_bank').select('industry, job_function, rating, use_as_ref, signals');
+  const cnt = (k: 'industry' | 'job_function') => { const m: Record<string, number> = {}; for (const r of all || []) { const v = r[k] || '（未归类）'; m[v] = (m[v] || 0) + 1; } return m; };
+  const stats = { total: (all || []).length, rated: (all || []).filter(r => r.rating).length, good: (all || []).filter(r => (r.rating || 0) >= 4).length, off: (all || []).filter(r => !r.use_as_ref).length, done: (all || []).filter(r => (r.signals?.sessions || 0) > 0).length };
+  return NextResponse.json({ ok: true, data, stats, industries: cnt('industry'), functions: cnt('job_function') });
+}
+
+export async function PATCH(req: NextRequest) {
+  const user = await getSessionUser(req);
+  if (!user || user.role !== 'admin') return NextResponse.json({ ok: false, error: '需要管理员' }, { status: 403 });
+  const body = await req.json();
+  const patch: Record<string, any> = { updated_at: new Date().toISOString() };
+  if (body.rating === null || (Number.isInteger(body.rating) && body.rating >= 1 && body.rating <= 5)) patch.rating = body.rating;
+  if (typeof body.use_as_ref === 'boolean') patch.use_as_ref = body.use_as_ref;
+  if (typeof body.note === 'string') patch.note = body.note.slice(0, 2000);
+  if (typeof body.job_function === 'string') patch.job_function = body.job_function.slice(0, 40) || null;
+  const { error } = await db.from('work_question_bank').update(patch).eq('id', String(body.id));
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  return NextResponse.json({ ok: true });
+}
+
+export async function POST(req: NextRequest) {
+  const user = await getSessionUser(req);
+  if (!user || user.role !== 'admin') return NextResponse.json({ ok: false, error: '需要管理员' }, { status: 403 });
+  const { data: ts } = await db.from('work_tasks').select('id').eq('if_delete', false).limit(2000).then(r => r.error ? db.from('work_tasks').select('id').limit(2000) : r);
+  let n = 0; for (const t of ts || []) { if (await bankTask(t.id)) n++; }
+  return NextResponse.json({ ok: true, banked: n });
+}
diff --git a/src/app/api/admin/work/attach/route.ts b/src/app/api/admin/work/attach/route.ts
new file mode 100644
index 0000000..466b1f8
--- /dev/null
+++ b/src/app/api/admin/work/attach/route.ts
@@ -0,0 +1,41 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { getSessionUser } from '@/lib/session';
+import { extractText } from '@/lib/work/samples';
+
+export const runtime = 'nodejs';
+export const maxDuration = 120;
+
+const MAX = 20 * 1024 * 1024;
+const BUCKET = 'lab-media';
+
+/**
+ * 题目附件（2026-10-24，产品负责人：有的题要读表格、读图片）——这是**给候选人的材料**，和「参考资料」（给 AI 照着出题的样本）是两回事。
+ * multipart { file }，登录即可。存到 lab-media/work-attach/<用户>/…；PDF / Word / 文本顺手抽成文字（出题和评卷能读），图片只存链接（候选人能看，出题 AI 看不了图）。
+ */
+export async function POST(req: NextRequest) {
+  const user = await getSessionUser(req);
+  if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const form = await req.formData();
+  const file = form.get('file') as File | null;
+  if (!file) return NextResponse.json({ ok: false, error: '没有文件' }, { status: 400 });
+  if (file.size > MAX) return NextResponse.json({ ok: false, error: '文件别超过 20MB' }, { status: 413 });
+  const safe = (file.name || 'file').replace(/[^\w.\-一-龥]+/g, '_').slice(0, 80);
+  const who = user.email.replace(/[^\w]+/g, '_').slice(0, 40);
+  // 存储 key 只用 ASCII（Supabase 不收中文 key）；显示名保留原文件名
+  const ext = (safe.match(/\.[A-Za-z0-9]{1,6}$/) || [''])[0].toLowerCase();
+  const path = `work-attach/${who}/${Date.now()}-${Math.random().toString(36).slice(2, 8)}${ext}`;
+  const buf = Buffer.from(await file.arrayBuffer());
+  const mime = file.type && file.type !== 'application/octet-stream' ? file.type : ({ '.csv': 'text/csv', '.txt': 'text/plain', '.md': 'text/markdown', '.pdf': 'application/pdf', '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.gif': 'image/gif', '.docx': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', '.xlsx': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' } as Record<string, string>)[ext] || 'application/octet-stream';
+  const { error } = await db.storage.from(BUCKET).upload(path, buf, { contentType: mime, upsert: true });
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  const url = db.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
+  let text = '';
+  if (/\.xlsx?$/i.test(safe) || /spreadsheetml|ms-excel/.test(mime)) {
+    // Excel：每个 sheet 抽成 CSV 文字（候选人端按表格渲染；出题 / 评卷能读）
+    try { const XLSX = await import('xlsx'); const wb = XLSX.read(buf, { type: 'buffer' }); text = wb.SheetNames.slice(0, 5).map(n => `## ${n}\n` + XLSX.utils.sheet_to_csv(wb.Sheets[n])).join('\n\n').slice(0, 20000); } catch {}
+  } else if (/pdf|word|officedocument|text\/|csv/.test(mime) || /\.(pdf|docx|txt|md|csv)$/i.test(safe)) { try { text = (await extractText(buf, safe)).slice(0, 20000); } catch {} }
+  const image = /^image\//.test(mime);
+  if (image && !text) { try { const { describeImage } = await import('@/lib/work/vision'); text = await describeImage(buf, mime, safe); } catch (e) { console.warn('[attach] 看图失败', String((e as any)?.message).slice(0, 100)); } }
+  return NextResponse.json({ ok: true, url, name: safe, mime, size: file.size, text, image });
+}
diff --git a/src/app/api/admin/work/chat/route.ts b/src/app/api/admin/work/chat/route.ts
new file mode 100644
index 0000000..e4805ff
--- /dev/null
+++ b/src/app/api/admin/work/chat/route.ts
@@ -0,0 +1,57 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { getSessionUser } from '@/lib/session';
+import { appendUser, runTurn, WS_MODEL, type Msg } from '@/lib/ws/agent';
+import { workChatKit } from '@/lib/work/chat-agent';
+import { isKnownModel } from '@/lib/model-options';
+
+export const runtime = 'nodejs';
+export const maxDuration = 300;
+
+/** 聊着出题：{ thread_id?, text, model? } → NDJSON 流（thread / text / tool_start / tool_end / ask / error / done）。历史存 work_threads（只看自己的）。 */
+export async function POST(req: NextRequest) {
+  const user = await getSessionUser(req); if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const body = await req.json().catch(() => ({}));
+  const text = String(body.text || '').trim().slice(0, 12000);
+  if (!text) return NextResponse.json({ ok: false, error: '说点什么' }, { status: 400 });
+  const model = isKnownModel(String(body.model || '')) ? String(body.model) : WS_MODEL;
+  let thread: any = null;
+  if (body.thread_id) ({ data: thread } = await db.from('work_threads').select('*').eq('id', String(body.thread_id)).eq('created_by', user.email).maybeSingle());
+  if (!thread) {
+    const { data, error } = await db.from('work_threads').insert({ created_by: user.email, title: text.replace(/\s+/g, ' ').slice(0, 28), messages: [] }).select('*').single();
+    if (error) return NextResponse.json({ ok: false, error: /work_threads/.test(error.message) ? '聊着出题还没开通（迁移 047 待跑）' : error.message }, { status: 500 });
+    thread = data;
+  }
+  const history: Msg[] = appendUser(thread.messages || [], text);
+  const kit = workChatKit({ email: user.email, role: user.role });
+  const enc = new TextEncoder();
+  const stream = new ReadableStream({
+    async start(controller) {
+      const send = (o: any) => { try { controller.enqueue(enc.encode(JSON.stringify(o) + '\n')); } catch {} };
+      send({ t: 'thread', id: thread.id, title: thread.title, model });
+      let added: Msg[] = [];
+      const save = async (a: Msg[]) => { await db.from('work_threads').update({ messages: [...history, ...a], updated_at: new Date().toISOString() }).eq('id', thread.id); };
+      try { added = await runTurn(history, model, { org: { name: '真活台', kind: 'work' }, email: user.email } as any, e => send(e), save, kit); }
+      catch (e: any) { send({ t: 'error', message: String(e?.message || e).slice(0, 400) }); }
+      // 这段对话出的题挂到线程上（右侧面板和「最近」列表用）
+      const task = [...added].reverse().flatMap((m: any) => (m.role === 'tool' ? m.results : [])).find((r: any) => r.ui?.kind === 'work_task');
+      await db.from('work_threads').update({ messages: [...history, ...added], ...(task ? { task_id: task.ui.task_id } : {}), updated_at: new Date().toISOString() }).eq('id', thread.id);
+      send({ t: 'done' });
+      controller.close();
+    },
+  });
+  return new Response(stream, { headers: { 'Content-Type': 'application/x-ndjson; charset=utf-8', 'Cache-Control': 'no-store', 'X-Accel-Buffering': 'no' } });
+}
+
+/** 我的对话列表；?id= 取一段 */
+export async function GET(req: NextRequest) {
+  const user = await getSessionUser(req); if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const id = new URL(req.url).searchParams.get('id');
+  if (id) {
+    const { data } = await db.from('work_threads').select('*').eq('id', id).eq('created_by', user.email).maybeSingle();
+    return data ? NextResponse.json({ ok: true, thread: data }) : NextResponse.json({ ok: false, error: '没有这段对话' }, { status: 404 });
+  }
+  const { data, error } = await db.from('work_threads').select('id, title, task_id, updated_at').eq('created_by', user.email).order('updated_at', { ascending: false }).limit(40);
+  if (error) return NextResponse.json({ ok: true, data: [] });   // 迁移 047 没跑
+  return NextResponse.json({ ok: true, data: data || [] });
+}
