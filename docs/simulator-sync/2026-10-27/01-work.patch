+}
+
+const H = ({ children }: { children: React.ReactNode }) => <div style={{ fontSize: 13, fontWeight: 600, color: BRAND.ink, margin: '18px 0 8px', borderLeft: `3px solid ${BRAND.primary}`, paddingLeft: 8 }}>{children}</div>;
