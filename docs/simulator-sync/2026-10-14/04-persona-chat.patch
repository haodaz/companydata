+        <div><div style={{ fontSize: 14, fontWeight: 600 }}>{j.company_ref?.name || j.institute_or_company_name}</div><div style={{ fontSize: 12, color: C.ink3 }}>{j.company_ref?.industry || ''}</div></div>
