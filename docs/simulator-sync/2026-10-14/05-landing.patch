+ *   右：示范评审五道关逐条亮起（守红线 / 达目标 / 讲得清 / 可复现 / 有增量），最后盖章定档（示范级）。
+ * 纯 SVG + requestAnimationFrame，颜色走 /lab 的 CSS 变量，深浅色都能看。
+ */
+import React, { useEffect, useState } from 'react';
+
+const GATES = ['守红线', '达目标', '讲得清', '可复现', '有增量'];
