+            { title: '企业 · 岗位', render: (_: any, t: any) => <span>{t.company_name} <Text type="secondary">· {t.role}</Text>{t.owner?.name && <Tag style={{ marginLeft: 6 }}>自助 · {t.owner.name}</Tag>}</span> },
