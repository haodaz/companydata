+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { getSessionUser } from '@/lib/session';
+import { runBaseline, WORK_MODEL } from '@/lib/work/generator';
+import { withCost } from '@/lib/token-logger';
+
+export const runtime = 'nodejs';
+export const maxDuration = 300;
+
+/** AI 基线：最强模型先把这道题做一遍，再用同一套 rubric 评它；候选人的报告拿它来比 */
+export async function POST(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const user = await getSessionUser(req);
+  if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const { id } = await params;
+  const { data: t } = await db.from('work_tasks').select('*').eq('id', id).maybeSingle();
+  if (!t) return NextResponse.json({ ok: false, error: '没有这道题' }, { status: 404 });
+  try {
+    const body = await req.json().catch(() => ({}));
+    const baseline = await withCost({ tool_name: 'work', task_name: 'Baseline · AI 先做一遍', stage: 'create', actor: user?.email || null }, () =>
+      runBaseline({ env: t.task?.env || { type: 'doc' }, problem: t.problem, task: t.task, materials: t.materials, rubric: t.rubric }, { model: body.model || WORK_MODEL, institution: t.company_name }));
+    const { error } = await db.from('work_tasks').update({ baseline, updated_at: new Date().toISOString() }).eq('id', id);
+    if (error) throw new Error(error.message);
+    return NextResponse.json({ ok: true, baseline: { model: baseline.model, total: baseline.result.total } });
+  } catch (e: any) {
+    return NextResponse.json({ ok: false, error: String(e?.message || e) }, { status: 500 });
+  }
+}
diff --git a/src/app/api/admin/work/tasks/[id]/route.ts b/src/app/api/admin/work/tasks/[id]/route.ts
new file mode 100644
index 0000000..68b1f27
--- /dev/null
+++ b/src/app/api/admin/work/tasks/[id]/route.ts
@@ -0,0 +1,48 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { getSessionUser } from '@/lib/session';
+
+export const runtime = 'nodejs';
+
+/** 只能动自己出的题；示范题和别人的题只有管理员能动 */
+async function canEdit(user: { email: string; role: string }, id: string) {
+  if (user.role === 'admin') return true;
+  const { data } = await db.from('work_tasks').select('created_by').eq('id', id).maybeSingle();
+  return !!data && data.created_by === user.email;
+}
+
+/** 一道题的全部：问题 / 任务 / 材料 / rubric / 基线 / 出题材料 + 所有作答 */
+export async function GET(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  if (!(await getSessionUser(req))) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const { id } = await params;
+  const { data: task, error } = await db.from('work_tasks').select('*').eq('id', id).maybeSingle();
+  if (error || !task) return NextResponse.json({ ok: false, error: error?.message || '没有这道题' }, { status: 404 });
+  const { data: sessions } = await db.from('work_sessions').select('id, participant, started_at, submitted_at, score, report').eq('task_id', id).order('created_at', { ascending: false });
+  return NextResponse.json({ ok: true, task, sessions: sessions || [] });
+}
+
+/** 改状态：{ status: 'published' | 'ready' | 'archived' }，或改标题 / 时限 */
+export async function PATCH(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const user = await getSessionUser(req);
+  if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const { id } = await params;
+  if (!(await canEdit(user, id))) return NextResponse.json({ ok: false, error: '只能改自己出的题' }, { status: 403 });
+  const body = await req.json();
+  const patch: Record<string, any> = { updated_at: new Date().toISOString() };
+  if (['ready', 'published', 'archived'].includes(body.status)) patch.status = body.status;
+  if (body.task && typeof body.task === 'object') patch.task = body.task;
+  if (body.rubric && Array.isArray(body.rubric)) patch.rubric = body.rubric;
+  const { error } = await db.from('work_tasks').update(patch).eq('id', id);
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  return NextResponse.json({ ok: true });
+}
+
+export async function DELETE(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const user = await getSessionUser(req);
+  if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const { id } = await params;
+  if (!(await canEdit(user, id))) return NextResponse.json({ ok: false, error: '只能删自己出的题' }, { status: 403 });
+  const { error } = await db.from('work_tasks').delete().eq('id', id);
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  return NextResponse.json({ ok: true });
+}
diff --git a/src/app/api/admin/work/tasks/route.ts b/src/app/api/admin/work/tasks/route.ts
new file mode 100644
index 0000000..ec73927
--- /dev/null
+++ b/src/app/api/admin/work/tasks/route.ts
@@ -0,0 +1,50 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { isKnownModel } from '@/lib/model-options';
+import { randomBytes } from 'node:crypto';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { getSessionUser } from '@/lib/session';
+import { gatherContext, generateTask, WORK_MODEL } from '@/lib/work/generator';
+import { withCost } from '@/lib/token-logger';
+
+export const runtime = 'nodejs';
+export const maxDuration = 300;
+
+/** 真活台 · 题目列表：登录即可。普通用户 = 自己出的 + 示范题（owner.contact = demo）；管理员 = 全部。带 owner_key 给真活空间链接 */
+export async function GET(req: NextRequest) {
+  const user = await getSessionUser(req);
+  if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  const base = 'id, share_token, owner_key, status, company_id, company_name, role, task, baseline, model, created_at, created_by, owner';
+  let r: { data: any[] | null; error: any } = await db.from('work_tasks').select(base).order('created_at', { ascending: false }).limit(300);
+  if (r.error) r = await db.from('work_tasks').select(base.replace(', owner_key', '').replace(', owner', '')).order('created_at', { ascending: false }).limit(300);   // 迁移 036 没跑
+  const { data, error } = r;
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  const isDemo = (t: any) => t.owner?.contact === 'demo';
+  const mine = (data || []).filter(t => user.role === 'admin' || t.created_by === user.email || isDemo(t));
+  const ids = mine.map(t => t.id);
+  const counts: Record<string, { n: number; done: number }> = {};
+  if (ids.length) {
+    const { data: ss } = await db.from('work_sessions').select('task_id, submitted_at').in('task_id', ids);
+    for (const x of ss || []) { const c = counts[x.task_id] ||= { n: 0, done: 0 }; c.n++; if (x.submitted_at) c.done++; }
+  }
+  return NextResponse.json({ ok: true, role: user.role, tasks: mine.map(t => ({ ...t, demo: isDemo(t), task: { title: t.task?.title, time_minutes: t.task?.time_minutes, env: t.task?.env }, baseline: t.baseline ? { total: t.baseline.result?.total, model: t.baseline.model } : null, sessions: counts[t.id] || { n: 0, done: 0 } })) });
+}
+
+/** 出一道题：{ company, company_id?, role, env?, focus? }。登录即可（用户 10-18：出题走登录，做题免登录）。生成器是核心：先拼材料，再出 问题 → 任务 → 材料包 → rubric；AI 基线另一步跑 */
+export async function POST(req: NextRequest) {
+  const user = await getSessionUser(req);
+  if (!user) return NextResponse.json({ ok: false, error: '需要登录' }, { status: 401 });
+  try {
+    const body = await req.json();
+    const company = String(body.company || '').trim(), role = String(body.role || '').trim();
+    if (!company || !role) return NextResponse.json({ ok: false, error: '企业和岗位都要填' }, { status: 400 });
+    const ctx = await gatherContext(body.company_id ? String(body.company_id) : company, role);
+    const { task, model } = await withCost({ tool_name: 'work', task_name: 'Generate · 出题', stage: 'create', actor: user?.email || null }, () => generateTask(ctx, role, { model: isKnownModel(String(body.model || '')) ? String(body.model) : WORK_MODEL, focus: body.focus, env: ['doc', 'code', 'sheet', 'design', 'open'].includes(body.env) ? body.env : undefined }));
+    const share_token = randomBytes(8).toString('base64url'), owner_key = randomBytes(12).toString('base64url');
