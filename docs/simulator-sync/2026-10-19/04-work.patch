+
+/** 操作台类型（比 NeoWork 多的一层：题按岗位选环境）：doc 文档 / 对账台 · code 代码台 · sheet 表格 / 数据台 · design 设计台（CAD 雏形） */
+export type WorkEnvType = 'doc' | 'code' | 'sheet' | 'design' | 'open';   // open：不用站内操作台，候选人用自己的软件做、录屏 + 上传交付
+export interface WorkEnv {
