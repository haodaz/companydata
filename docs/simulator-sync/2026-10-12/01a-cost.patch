+
+        {/* 按空间 */}
+        {!!s.space_stats?.length && (
+          <div className="lab-card" style={{ padding: 16, marginBottom: 16 }}>
+            <b>按空间（花得最多的 30 个）</b>
+            <Table size="small" rowKey="space_id" pagination={false} style={{ marginTop: 10 }} dataSource={s.space_stats} scroll={{ x: 760 }}
+              columns={[
