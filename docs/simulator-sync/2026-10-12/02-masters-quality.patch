+      case 'fuel': if (!placed) { say('泵还没就位'); return; } act('fuel', 1); return;
+      case 'hose': act('hose_out', hoseOut ? 0 : 1); return;
+      case 'pump': if (!placed) { say('泵还没就位'); return; } if (!fueled) say('没加油，泵转不起来'); act('pump_on', c.pump_on === 1 ? 0 : 1); return;
