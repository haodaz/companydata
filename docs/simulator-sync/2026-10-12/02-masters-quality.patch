+      { id: 'ign_s', label: '点火器余焰', initial: 0, set: 'igniter == 1 ? 3 : max(0, ign_s - dt)' },
+      // 紧急关机会把主阀一起关掉，所以关机后不再往燃烧室里积
+      { id: 'wet', label: '燃烧室里积的推进剂', initial: 0, set: 'lit == 1 || aborted == 1 ? 0 : ((mv_fuel == 1 || mv_ox == 1) && ign_s <= 0 ? min(10, wet + dt) : wet)' },
