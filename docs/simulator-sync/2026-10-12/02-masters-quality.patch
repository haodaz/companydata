+  const busy = new Set(bp ? [8, 9, 15, 16, 22, 23] : []);
+  let pend = 0, got = 0, frames = 0, gap = 0, prevValid = 0;
+  for (let i = 0; i < N; i++) {
+    const rst = i < 4;
+    if (!rst) { if (!pend && frames < 4 && gap <= 0) { pend = 1; frames++; } }
