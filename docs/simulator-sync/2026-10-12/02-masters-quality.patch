+  }
+
+  return (
+    <div style={{ ...root, display: 'grid', gridTemplateRows: '52px minmax(0, 1fr)', gridTemplateColumns: cfg.columns || `repeat(${cfg.panes.length}, minmax(0, 1fr))`, gap: `0 ${gap}px`, padding: gap ? `0 ${gap}px ${gap}px` : 0 }}>
