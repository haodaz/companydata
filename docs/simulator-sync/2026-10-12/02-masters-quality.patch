+  const placed = (v.placed || 0) >= 1, fueled = (v.fueled || 0) >= 1, pumping = (v.pumping || 0) >= 1, hoseOut = c.hose_out === 1, overtop = (v.overtop || 0) >= 1, fail = (v.dike_fail || 0) >= 1, held = (v.held || 0) >= 1;
