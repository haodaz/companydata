+  push(42, 'refill', 1);                                        // 水箱先补水
+  push(60, 'refill', 0); push(62, 'mist', 1);                   // 补到位再开雾
+  push(70, 'fan', 1);
+  push(95, 'vent', 50);                                         // 温度下来了，窗收一半保 CO₂
+  push(110, 'mist', 0);                                         // 湿度够了停雾
+  push(125, 'log', 1);
+  push(152, 'vent', 20); push(154, 'fan', 0);                   // 下雨：顶窗收到 20%
+  push(185, 'vent', 40);                                        // 雨停
+  return a;
+}
