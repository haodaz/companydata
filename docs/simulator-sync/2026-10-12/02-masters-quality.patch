+/** BenchRunner 场景层的盒子（百分比 → 场景坐标），和代码版 Layer 里一样的算法 */
+const box = (l: BenchLayer) => { const x = l.x * 16, y = l.y * 9, w = l.w * 16, h = l.h * 9; return { x, y, w, h, cx: x + w / 2, cy: y + h / 2 }; };
