+              <Text type="secondary" style={{ fontSize: 12.5 }}>{c.company_name} · {c.role}{c.industry ? ` · ${c.industry}` : ''}</Text>
+            </div>
+            <Space size={4} wrap>
+              <Tag color="purple">基线 {c.signals?.baseline_total ?? '—'}</Tag>
+              {!!c.signals?.sessions && <Tag>做过 {c.signals.sessions} 次</Tag>}
