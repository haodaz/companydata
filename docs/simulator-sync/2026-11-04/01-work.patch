diff --git a/src/app/api/admin/work/governance/route.ts b/src/app/api/admin/work/governance/route.ts
new file mode 100644
index 0000000..be7e2cf
--- /dev/null
+++ b/src/app/api/admin/work/governance/route.ts
@@ -0,0 +1,25 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { getSessionUser } from '@/lib/session';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { CASES, GOVERNANCE } from '@/lib/work/ai-policy';
+
+export const runtime = 'nodejs';
+
+/** 真活后台 · 法规清单（2026-10-30）：AI 使用标准能引用的法规 / 行业规范，每条适用范围，以及被多少道真活的 AI 使用标准引用了 */
+export async function GET(req: NextRequest) {
+  const u = await getSessionUser(req);
+  if (!u || u.role !== 'admin') return NextResponse.json({ ok: false, error: '只有管理员能看' }, { status: 403 });
+  const { data, error } = await db.from('work_tasks').select('id, company_name, role, share_token, sources:task->ai_policy->sources').not('task->ai_policy', 'is', null).limit(2000);
+  if (error) return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
+  const cited = new Map<string, { id: string; company: string; role: string }[]>();
+  for (const t of data || []) for (const k of Object.keys((t as any).sources || {})) if (/^(G|X):/.test(k)) {
+    const id = k.slice(2); if (!cited.has(id)) cited.set(id, []);
+    cited.get(id)!.push({ id: t.id, company: t.company_name, role: t.role });
+  }
+  const scopeText = (s: RegExp | 'all') => (s === 'all' ? '所有岗位' : s.source.split('|').slice(0, 10).join('、'));
+  return NextResponse.json({
+    ok: true, policies: (data || []).length,
+    cases: CASES.map(c => ({ id: c.id, title: c.title, when: c.when, what: c.what, lesson: c.lesson, url: c.url, scope: scopeText(c.scope), all: c.scope === 'all', cited: (cited.get(c.id) || []).length, tasks: (cited.get(c.id) || []).slice(0, 8) })),
+    items: GOVERNANCE.map(g => ({ id: g.id, name: g.name, point: g.point, url: g.url || null, scope: scopeText(g.scope), all: g.scope === 'all', cited: (cited.get(g.id) || []).length, tasks: (cited.get(g.id) || []).slice(0, 8) })),
+  });
+}
diff --git a/src/app/api/admin/work/showcase/route.ts b/src/app/api/admin/work/showcase/route.ts
new file mode 100644
index 0000000..74d34e6
--- /dev/null
+++ b/src/app/api/admin/work/showcase/route.ts
@@ -0,0 +1,39 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { getSessionUser } from '@/lib/session';
+import { supabaseAdmin as db } from '@/lib/supabase';
+import { deidentifyToShowcase, showcaseCandidates } from '@/lib/work/showcase';
+import { withCost } from '@/lib/token-logger';
+
+export const runtime = 'nodejs';
+export const maxDuration = 120;
+
+const admin = async (req: NextRequest) => { const u = await getSessionUser(req); return u && u.role === 'admin' ? u : null; };
+const no = () => NextResponse.json({ ok: false, error: '只有管理员能管任务库' }, { status: 403 });
+
+/** 任务库上架台：候选（题目资产库里的好题）+ 已去头待看的 + 已上架的 */
+export async function GET(req: NextRequest) {
+  if (!(await admin(req))) return no();
+  try { return NextResponse.json({ ok: true, ...(await showcaseCandidates()) }); }
+  catch (e: any) { return NextResponse.json({ ok: false, error: String(e?.message || e) }, { status: 500 }); }
+}
+
+/** 去头：{ task_id } → AI 写展示题面，存成 draft */
+export async function POST(req: NextRequest) {
+  const u = await admin(req); if (!u) return no();
+  const { task_id } = await req.json().catch(() => ({}));
+  if (!task_id) return NextResponse.json({ ok: false, error: '缺 task_id' }, { status: 400 });
+  try { return NextResponse.json({ ok: true, item: await withCost({ tool_name: 'work', task_name: 'Showcase · 去头上架', stage: 'create', actor: u.email }, () => deidentifyToShowcase(String(task_id), u.email)) }); }
+  catch (e: any) { return NextResponse.json({ ok: false, error: String(e?.message || e) }, { status: 500 }); }
+}
+
+/** 改字段 / 上架 / 不上：{ id, title?, scenario?, role?, industry?, direction?, status? } */
+export async function PATCH(req: NextRequest) {
+  if (!(await admin(req))) return no();
+  const b = await req.json().catch(() => ({}));
+  if (!b.id) return NextResponse.json({ ok: false, error: '缺 id' }, { status: 400 });
+  const up: Record<string, any> = { updated_at: new Date().toISOString() };
+  for (const k of ['title', 'scenario', 'role', 'industry', 'direction']) if (typeof b[k] === 'string') up[k] = b[k].slice(0, k === 'scenario' ? 800 : 80);
+  if (['draft', 'live', 'hidden'].includes(b.status)) up.status = b.status;
+  const { error } = await db.from('work_showcase').update(up).eq('id', String(b.id));
+  return error ? NextResponse.json({ ok: false, error: error.message }, { status: 500 }) : NextResponse.json({ ok: true });
+}
