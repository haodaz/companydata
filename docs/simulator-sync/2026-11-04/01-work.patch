+}
+
+/** 待看的一条：标题 / 要找的人 / 背景可改，上架或不上 */
+function DraftCard({ x, busy, e, setE, onSave, onLive, onHide }: { x: any; busy: boolean; e: any; setE: (v: any) => void; onSave: () => void; onLive: () => void; onHide: () => void }) {
+  const v = (k: string) => (e[k] ?? x?.[k] ?? '');
