+  const w: Record<string, number> = pol?.weights || { ask: 20, verify: 20, select: 20, divide: 20, integrate: 20 };
+  const raw = Math.round(items.reduce((n, i) => n + i.score * (w[i.key] ?? 20), 0) / (items.reduce((n, i) => n + (w[i.key] ?? 20), 0) || 1));
