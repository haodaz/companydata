# 变量名与院校版（programcrawler）完全一致；复制为 .env.local 后填值。
# 只有 Supabase 两项需要换成企业版自己的 Supabase 项目，其余可直接沿用院校版的值。

# ── Supabase（企业版独立项目）────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 仅服务端使用，切勿暴露到前端
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini（默认模型 + Google Search 联网检索）https://aistudio.google.com
GEMINI_API_KEY=
# OpenAI（可选，侧栏切换到 GPT 模型时使用）
OPENAI_API_KEY=

# ── 登录 ─────────────────────────────────────────────────────────────────────
# JWT 签名密钥，生产环境必须设置（openssl rand -base64 48）
JWT_SECRET=
