/** 陈彩瑛 11-25 抽检 50 条回测：新规则重打特色标签，和她的批注并排看（不写库） */
process.loadEnvFile('.env.local');
import XLSX from 'xlsx';
const { supabaseAdmin: db } = await import('@/lib/supabase');
const { tagJobSpecialties } = await import('@/lib/qianli-labels');
const { SPECIALTY_TAGS } = await import('@/data/qianli-prompts');
const zh = new Map(SPECIALTY_TAGS.map(t => [t.l2_value, t.l2]));
const file = process.argv[2] || '/Users/aisandbox/Desktop/潜历标签重跑明细-20261124.xlsx';
const SHEET = Number(process.argv[3] || 1), COL = process.argv[4] || '潜历特色标签（二级）', OUTF = process.argv[5] || 'reports/潜历特色标签回测-20261125.xlsx';
const wb = XLSX.readFile(file);
const rows: any[] = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[SHEET]], { defval: '' });
const ids = rows.map(r => Number(r['岗位ID']));
const { data } = await db.from('jobs').select('id,name,institute_or_company_name,responsibilities,overview').in('id', ids);
const jobs = (data as any[]).map(j => ({ ...j, company: j.institute_or_company_name }));
const out = new Map<number, any>();
const chunks: any[][] = []; for (let i = 0; i < jobs.length; i += 10) chunks.push(jobs.slice(i, i + 10));
await Promise.all(chunks.map(async c => { for (const [k, v] of await tagJobSpecialties(c, 'qwen3.7-plus')) out.set(k, v); }));
const res = rows.map(r => ({ 岗位ID: r['岗位ID'], 岗位名称: r['岗位名称'], 原二级: r[COL], 新二级: (out.get(Number(r['岗位ID']))?.l2 || []).map((x: string) => zh.get(x) || x).join('；'), 她的核对: r['核对（对 / 错 / 存疑）'], 她的备注: r['备注'] }));
for (const r of res) console.log(`${r.岗位ID} ${String(r.岗位名称).slice(0, 18)} | 原 ${r.原二级} → 新 ${r.新二级} | ${r.她的核对} ${String(r.她的备注).slice(0, 70)}`);
const ws = XLSX.utils.json_to_sheet(res); ws['!cols'] = [{ wch: 8 }, { wch: 26 }, { wch: 28 }, { wch: 36 }, { wch: 14 }, { wch: 80 }];
const wb2 = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb2, ws, '50 条回测'); XLSX.writeFile(wb2, OUTF);
process.exit(0);
