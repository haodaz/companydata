  "gauges": [
   {
    "id": "g_depth",
    "max": 80,
    "min": 0,
    "expr": "depth",
    "unit": "cm",
    "warn": "depth > 60 || (depth < 30 && depth > 5)",
    "label": "探铲入土深度",
    "digits": 0
   },
   {
    "id": "g_water",
    "max": 70,
    "min": 0,
    "expr": "depth < 20 ? 12 : (depth < 40 ? 28 : 58)",
    "unit": "%",
    "warn": "depth >= 40",
    "label": "深层土壤含水率",
    "digits": 0
   },
   {
    "id": "g_dev",
