{
 "id": "bench",
 "type": "bench",
 "bench": {
  "name": "特规树木根际微创勘测与应急排气工位",
  "vars": [
   {
    "id": "prev_pos",
    "set": "probe_path",
    "initial": 0
   },
   {
    "id": "speed",
    "max": 10,
    "min": 0,
    "set": "(probe_path - prev_pos) / dt",
    "label": "探移速度",
    "initial": 0
   },
   {
    "id": "dev_mm",
    "max": 320,
    "min": 0,
    "set": "dev * 0.8",
    "label": "点位偏离距",
    "initial": 0
   },
   {
    "id": "in_zone",
    "set": "depth >= 45 && depth <= 55 ? 1 : 0",
    "label": "有效探层",
    "initial": 0
   },
   {
    "id": "sample_valid",
    "set": "max(sample_valid, (sample_btn == 1 && in_zone == 1 ? 1 : 0))",
    "label": "有效深层取样",
    "initial": 0
   },
   {
    "id": "drag_stress",
    "set": "depth > 15 && speed > 0.8 ? 1 : 0",
    "label": "带土横移应力",
    "initial": 0
   },
   {
    "id": "dev_acc",
    "rate": "speed > 0.1 ? dev_mm : 0",
    "initial": 0
   },
   {
    "id": "move_time",
    "rate": "speed > 0.1 ? 1 : 0",
    "initial": 0
   },
   {
    "id": "avg_dev",
    "set": "move_time > 1 ? dev_acc / move_time : 0",
    "label": "平均点位偏离",
    "initial": 0
   },
   {
    "id": "water_detected",
    "set": "depth >= 45 ? 1 : 0",
    "label": "滞水黑臭液探出",
    "initial": 0
   }
  ],
  "brief": "手持洛阳铲与土壤探针，沿下沉中庭红枫土球外缘滴水线进行四向定点钻孔探查。目标：严控行进轨迹规避主根骨干，垂直进铲穿透30 cm板结硬层至45–55 cm深部滞水沤根层，逐点提取厌氧土样并植入透气滤水管，为复壮方案提供一手地下立地数据。",
  "goals": [
   {
    "id": "deep_core",
    "hold": 2,
    "when": "in_zone == 1",
    "label": "探铲穿透硬层，深入45–55cm厌氧渍水层"
   },
   {
    "id": "extract_sample",
    "when": "sample_valid == 1",
    "after": "deep_core",
    "label": "提铲取出黑臭水浸根土样并获取理化数据"
   },
   {
    "id": "full_perimeter",
    "when": "probe_path >= 90",
    "after": "extract_sample",
    "label": "稳步完成树穴四向环周探查巡线（>= 90%）"
   },
   {
    "id": "retract_tool",
    "when": "depth <= 10",
    "after": "full_perimeter",
    "label": "巡线打通后回提探铲至安全高度（<= 10cm）"
   },
   {
    "id": "install_vents",
    "when": "vent_pipe == 1 && avg_dev < 80",
    "after": "retract_tool",
    "label": "在排气导水孔位规范植入透气花管"
   }
  ],
  "rules": [
   {
    "id": "root_cut",
    "once": false,
    "when": "dev_mm > 120 && depth > 20",
    "label": "铲位内偏过大：误伤红枫骨干侧根！",
    "severity": "violation"
   },
   {
    "id": "waterproof_punctured",
    "once": false,
    "when": "depth > 65",
    "label": "下探超深破坏下沉广场结构防水卷材！",
    "severity": "violation"
   },
   {
    "id": "lateral_tear",
    "once": false,
    "when": "drag_stress == 1",
    "label": "深铲入土状态下横向强行移位（土球撕裂）",
    "severity": "violation"
   },
   {
    "id": "shallow_sample",
    "once": true,
    "when": "sample_btn == 1 && depth < 35",
    "label": "未穿透板结层即取样：仅测得表干假象！",
    "severity": "warning"
   },
   {
    "id": "pipe_too_early",
    "once": true,
    "when": "vent_pipe == 1 && sample_valid == 0",
    "label": "探孔未钻到底即盲目插入透气管",
    "severity": "warning"
   }
  ],
  "scene": {
