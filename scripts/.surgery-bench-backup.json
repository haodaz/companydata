{
 "name": "开腹工位 · 麦氏切口分层入腹",
 "vars": [
  {
   "id": "prev",
   "set": "cut",
   "initial": 0
  },
  {
   "id": "rate_c",
   "max": 60,
   "min": 0,
   "set": "(cut - prev) / dt",
   "label": "推进速度",
   "initial": 0
  },
  {
   "id": "cutting",
   "set": "rate_c > 0.4 ? 1 : 0",
   "initial": 0
  },
  {
   "id": "pass",
   "max": 5,
   "min": 0,
   "set": "(cut >= 20 ? 1 : 0) + (cut >= 40 ? 1 : 0) + (cut >= 60 ? 1 : 0) + (cut >= 80 ? 1 : 0) + (cut >= 100 ? 1 : 0)",
   "label": "已完成层次",
   "initial": 0
  },
  {
   "id": "dev_sum",
   "rate": "cutting == 1 ? dev : 0",
   "initial": 0
  },
  {
   "id": "dev_time",
   "rate": "cutting == 1 ? 1 : 0",
   "initial": 0
  },
  {
   "id": "dev_avg",
   "set": "dev_time > 0.5 ? dev_sum / dev_time : 0",
   "label": "平均偏离",
   "initial": 0
  },
  {
   "id": "sharp_muscle",
   "max": 14,
   "rate": "cutting == 1 && depth > 16 && depth <= 24 && tool < 2 ? 1 : 0",
   "label": "肌层用锐性的秒数",
   "initial": 0
  },
  {
   "id": "blind_perit",
   "max": 14,
   "rate": "cutting == 1 && depth > 24 && depth <= 29 && tool != 3 && pass < 4 ? 1 : 0",
   "label": "腹膜未提起就切的秒数",
   "initial": 0
  },
  {
   "id": "too_deep",
   "max": 14,
   "rate": "depth > 32 ? 1 : 0",
   "label": "进腹过深的秒数",
   "initial": 0
  },
  {
   "id": "blunt_skin",
   "max": 14,
   "rate": "cutting == 1 && depth <= 12 && tool >= 2 ? 1 : 0",
   "label": "皮肤用钝性的秒数",
   "initial": 0
  },
  {
   "id": "no_retract",
   "max": 14,
   "rate": "cutting == 1 && depth > 24 && retract == 0 ? 1 : 0",
   "label": "没牵开就深入的秒数",
   "initial": 0
  },
  {
   "id": "stall",
   "set": "cut > 3 && cut < 99 && rate_c < 0.4 ? stall + dt : 0",
   "label": "停顿秒数",
   "initial": 0
  },
  {
   "id": "stall_max",
   "set": "max(stall_max, stall)",
   "initial": 0
  },
  {
   "id": "bowel_risk",
   "max": 100,
   "min": 0,
   "set": "clamp(blind_perit * 6 + too_deep * 9, 0, 100)",
   "label": "肠管损伤风险",
   "initial": 0
  },
  {
   "id": "quality",
   "max": 100,
   "min": 0,
   "set": "clamp(100 - dev_avg * 0.4 - sharp_muscle * 4 - blind_perit * 4.5 - too_deep * 5 - blunt_skin * 2.5 - no_retract * 2.5 - max(0, 5 - pass) * 12 - max(0, stall_max - 6) * 3, 0, 100)",
   "label": "入腹质量",
   "initial": 0
  }
 ],
 "brief": "急性阑尾炎，右下腹麦氏点斜切口开腹。五趟走完五个层次：皮肤皮下锐性切开 → 腱膜沿纤维切开 → 肌层钝性分离 → 提起腹膜再切开 → 牵开显露。每一层该用刀还是该用钳，用错了系统当场记。（教学化简化模型，不构成医疗指导）",
 "goals": [
  {
   "id": "skin",
   "when": "cut >= 20 && tool < 2 && depth >= 3 && depth <= 12",
   "label": "第一趟：手术刀锐性切开皮肤与皮下"
  },
  {
   "id": "fascia",
   "when": "cut >= 40 && depth > 12 && depth <= 16",
   "after": "skin",
   "label": "第二趟：沿纤维方向切开腹外斜肌腱膜"
  },
  {
   "id": "muscle",
   "when": "cut >= 60 && depth > 16 && depth <= 24 && tool == 2 && sharp_muscle < 1",
   "after": "fascia",
   "label": "第三趟：肌层钝性分离（血管钳，不用刀）"
  },
  {
   "id": "perit",
   "when": "cut >= 80 && depth > 24 && depth <= 29 && tool == 3 && blind_perit < 1",
   "after": "muscle",
   "label": "第四趟：提起腹膜形成帐篷后切开"
  },
  {
   "id": "expose",
   "when": "cut >= 100 && retract == 1",
   "after": "perit",
   "label": "上牵开器，显露回盲部"
  },
  {
   "id": "safe",
   "when": "pass >= 5 && bowel_risk < 10 && quality >= 70",
   "after": "expose",
   "label": "安全入腹：未伤及肠管、入腹质量 ≥ 70 分"
  }
 ],
 "rules": [
  {
   "id": "sharp_muscle",
   "once": true,
   "when": "cutting == 1 && depth > 16 && depth <= 24 && tool < 2",
   "label": "肌层用刀锐性切开（腹内斜肌与腹横肌应钝性分离，锐切出血多且无必要）",
   "severity": "violation"
  },
  {
   "id": "blind_perit",
   "once": true,
   "when": "cutting == 1 && depth > 24 && depth <= 29 && tool != 3 && pass < 4",
   "label": "没提起腹膜就切（刀尖下面可能就是肠管）",
   "severity": "violation"
  },
  {
   "id": "too_deep",
   "when": "depth > 32",
   "label": "进腹过深，已超过腹膜层（肠管损伤）",
   "severity": "violation"
  },
  {
   "id": "blunt_skin",
   "once": true,
   "when": "cutting == 1 && depth <= 12 && tool >= 2",
   "label": "用血管钳去分离皮肤皮下（该锐性的层次别钝性撕）",
   "severity": "warning"
  },
  {
   "id": "no_retract",
   "once": true,
   "when": "cutting == 1 && depth > 24 && retract == 0",
   "label": "没上牵开器就往深层走（显露不清）",
   "severity": "warning"
  },
  {
   "id": "skip",
   "once": true,
   "when": "cutting == 1 && depth > 16 && pass < 2",
   "label": "层次跳跃：上一层还没走完就加深",
   "severity": "violation"
  },
  {
   "id": "off",
   "when": "cutting == 1 && dev > 150",
   "label": "偏离切口轴线（切口歪斜、显露困难）",
   "severity": "violation"
  },
  {
   "id": "rush",
   "when": "cutting == 1 && rate_c > 8",
   "label": "推进过快（层次辨认不清）",
   "severity": "warning"
  }
 ],
