    "min": 0,
    "hint": "0:待定 1:合规跨期放行 2:揭示在途差额 3:定性舞弊/大股东倒账",
    "kind": "knob",
    "step": 1,
    "unit": "档",
    "label": "实质性核验结论",
    "hidden": false,
    "initial": 0
   },
   {
    "id": "sign_tick",
    "max": 100,
    "min": 0,
    "hint": "完成核对后盖章归档该项底稿，未查单据盲签将触发质控违规",
    "kind": "button",
    "unit": "",
    "label": "签署Tickmark底稿印鉴",
    "hidden": false,
    "initial": 0
   }
  ],
