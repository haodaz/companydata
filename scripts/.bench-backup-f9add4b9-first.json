    "max": 4,
    "min": 0,
    "hint": "黑表笔搭0V；0:悬空，1:端子101，2:端子102，3:端子103(FR2后)，4:端子104",
    "kind": "knob",
    "step": 1,
    "unit": "号",
    "label": "红表笔测点",
    "hidden": false,
    "initial": 0
   },
   {
    "id": "jam_cleared",
    "max": 100,
    "min": 0,
    "hint": "去线体取出卡阻纸箱，并用手盘动输送皮带辊确认无机械卡死",
    "kind": "switch",
    "unit": "",
