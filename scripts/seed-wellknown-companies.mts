const toRow = (r: Row) => ({
  name: r[0], industry: r[1], product_area: r[2], city: r[3], one_sentence: r[4],
  source: 'seed-wellknown', note: '补录的知名企业，用于职业生态的上下游展示；仅公开常识级信息',
  country: '中国',
});

const { data: exist } = await supabaseAdmin.from('companies').select('id, name, industry, product_area, city, one_sentence');
const byName = new Map((exist || []).map((c: any) => [c.name, c]));

let add = 0, fill = 0, skip = 0;
for (const r of ROWS) {
  const row = toRow(r);
  const old = byName.get(row.name);
  if (!old) {
    console.log(`+ ${row.name}  ${row.industry}`);
    if (!dry) { const { error } = await supabaseAdmin.from('companies').insert(row); if (error) { console.log(`  ❌ ${error.message}`); continue; } }
    add++; continue;
  }
  // 已存在：只补空字段，不动已有内容
  const patch: Record<string, string> = {};
  for (const k of ['industry', 'product_area', 'city', 'one_sentence'] as const) if (!old[k] && (row as any)[k]) patch[k] = (row as any)[k];
  if (!Object.keys(patch).length) { skip++; continue; }
  console.log(`~ ${row.name}  补 ${Object.keys(patch).join('/')}`);
  if (!dry) await supabaseAdmin.from('companies').update(patch).eq('id', old.id);
  fill++;
}
console.log(`\n${dry ? '（--dry 没有写库）' : ''}新增 ${add} · 补字段 ${fill} · 已完整跳过 ${skip}  / 共 ${ROWS.length}`);
