{
 "id": "bench",
 "type": "bench",
 "bench": {
  "name": "离园前突发抓痕轻柔冷敷与情绪安抚工位",
  "vars": [
   {
    "id": "trace_prev",
    "set": "trace",
    "initial": 0
   },
   {
    "id": "speed",
    "max": 20,
    "min": 0,
    "set": "(trace - trace_prev) / dt",
    "label": "冷敷移动速度",
    "initial": 0
   },
   {
    "id": "cold_relief",
    "max": 100,
    "min": 0,
    "rate": "pressure >= 10 && pressure <= 25 && gauze_layer >= 2 && gauze_layer <= 3 ? 2.5 : 0",
    "label": "充血消退度",
    "initial": 0
   },
   {
    "id": "child_distress",
    "max": 100,
    "min": 0,
    "rate": "comfort == 1 && pressure <= 25 ? -1.8 : (pressure > 25 ? 1.5 : -0.2)",
    "label": "幼儿应激指数",
    "initial": 50
   },
   {
    "id": "dev_sum",
    "rate": "pressure > 5 ? dev : 0",
    "initial": 0
   },
   {
    "id": "dev_time",
    "rate": "pressure > 5 ? 1 : 0",
    "initial": 0
   },
   {
    "id": "dev_avg",
    "set": "dev_time > 0.5 ? dev_sum / dev_time : 0",
    "label": "平均偏离度",
    "initial": 0
   }
  ],
  "brief": "幼儿离园前突发手背浅表划痕（未破皮）。教师需先规范折叠医用隔温纱布并开启温和口头安抚，施加适度轻压力，手持冷敷包沿红痕外周做轻柔环形冷敷舒缓，促使毛细血管收缩充血消退并平复幼儿应激情绪，完成后平稳撤除进入离园交接。",
  "goals": [
   {
    "id": "goal_gauze",
    "hold": 1,
    "when": "gauze_layer >= 2 && gauze_layer <= 3",
    "label": "规范折叠隔温纱布（2-3层）"
   },
   {
    "id": "goal_comfort",
    "hold": 1,
    "when": "comfort == 1",
    "label": "开启低语轻拍安抚稳定幼儿情绪"
   },
   {
    "id": "goal_pressure",
    "hold": 2,
    "when": "pressure >= 10 && pressure <= 25",
    "after": "goal_gauze",
    "label": "贴敷力度平稳控制在适宜区间（10-25 cN）"
   },
   {
    "id": "goal_trace_done",
    "when": "trace >= 100",
    "after": "goal_pressure",
    "label": "沿外周完成全程平稳环形轻敷"
   },
   {
    "id": "goal_relief",
    "when": "cold_relief >= 75 && child_distress <= 15",
    "after": "goal_trace_done",
    "label": "浅红痕充血消退达标且幼儿情绪平复"
   },
   {
    "id": "goal_finish",
    "when": "pressure == 0 && trace >= 100",
    "after": "goal_relief",
    "label": "平稳撤离冷敷包，完成离园交接前检查"
   }
  ],
  "rules": [
   {
    "id": "frostbite_risk",
    "once": false,
    "when": "pressure > 5 && gauze_layer < 2",
    "label": "隔温纱布过薄直接贴敷（易致冻伤红肿）",
    "severity": "violation"
   },
   {
    "id": "excessive_force",
    "once": false,
    "when": "pressure > 28",
    "label": "贴敷力度超过25cN（压迫疼痛加重）",
    "severity": "violation"
   },
   {
    "id": "rubbing_too_fast",
    "once": false,
    "when": "speed > 6.0 && pressure > 5",
    "label": "移动速度过快（摩擦表皮加剧发红）",
    "severity": "violation"
   },
   {
    "id": "unsoothed_distress",
    "once": false,
    "when": "pressure > 15 && comfort == 0 && child_distress > 30",
    "label": "未开启言语情绪安抚即强行冷敷",
    "severity": "warning"
   }
  ],
