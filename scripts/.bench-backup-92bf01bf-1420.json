     "cold": false,
     "kind": "lamp",
     "color": "#ef4444",
     "label": "流失预警"
    },
    {
     "h": 36,
     "w": 30,
     "x": 38,
     "y": 32,
     "id": "l_stream_traffic",
     "on": "prod_select == 4",
     "cold": false,
     "kind": "stream",
     "color": "#f59e0b"
    },
    {
     "h": 14,
     "w": 10,
     "x": 84,
     "y": 40,
     "id": "l_pulse_orders",
     "on": "orders_count > 100",
     "cold": false,
     "kind": "pulse",
     "color": "#ec4899"
    }
   ]
  },
  "gauges": [
   {
