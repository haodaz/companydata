{
 "id": "bench",
 "type": "bench",
 "bench": {
  "name": "电商直播中控应急调度台",
  "vars": [
   {
    "id": "retained_time",
    "max": 75,
    "min": 10,
    "rate": "prod_select == 4 && cue_board == 2 && pop_welfare == 1 ? 0.35 : (prod_select == 1 ? -0.08 : 0.1)",
    "label": "平均停留时长",
    "initial": 18
   },
   {
    "id": "online_users",
    "max": 3500,
    "min": 400,
    "rate": "retained_time < 22 ? -18 : (retained_time > 35 ? 4 : -3)",
    "label": "在线人数",
    "initial": 2200
   },
   {
    "id": "stock_trigger",
    "set": "stock_btn",
    "initial": 0
   },
   {
    "id": "welfare_sold",
    "max": 600,
    "min": 0,
    "rate": "stock_trigger == 1 && welfare_sold < 400 ? 50 : 0",
    "label": "秒杀库存释放量",
    "initial": 0
   },
   {
    "id": "risk_score",
    "max": 100,
    "min": 0,
    "rate": "shield_switch == 1 ? -0.8 : 0.6",
    "label": "公屏负面违规分",
    "initial": 15
   },
   {
    "id": "orders_count",
    "max": 1200,
    "min": 0,
    "rate": "prod_select == 4 && cue_board >= 2 ? (cue_board == 3 ? 5.5 : 3.2) : 0",
    "label": "49.9爆款累积单量",
    "initial": 0
   }
  ],
  "brief": "千川投流大额流量洪峰涌入，直播间人数暴涨但停留骤降。初级中控需在3分钟窗口期内迅速完成转品弹窗、切换主播提词、开启负面弹幕拦截，并梯度释放秒杀库存承接流量。",
  "goals": [
   {
    "id": "g_shield_active",
    "hold": 3,
    "when": "shield_switch == 1 && risk_score < 20",
    "label": "开启违规拦截盾净化公屏"
   },
   {
    "id": "g_change_hero",
    "hold": 5,
    "when": "prod_select == 4 && cue_board == 2",
    "after": "g_shield_active",
    "label": "切主推品至4号沐浴露并递白板提词2档"
   },
   {
    "id": "g_welfare_cadence",
    "hold": 5,
    "when": "pop_welfare == 1 && welfare_sold >= 200 && welfare_sold <= 400",
    "after": "g_change_hero",
    "label": "开启互动福袋并分批注入秒杀库存至200单以上"
   },
   {
    "id": "g_retention_recovered",
    "hold": 10,
    "when": "retained_time >= 45 && online_users >= 1200",
    "after": "g_welfare_cadence",
    "label": "承接住大流量：停留时长重回45秒以上"
   },
   {
    "id": "g_harvest_orders",
    "hold": 5,
    "when": "cue_board == 3 && orders_count >= 300",
    "after": "g_retention_recovered",
    "label": "切提词3档逼单收割：沐浴露爆单破300单"
   }
  ],
  "rules": [
   {
    "id": "r_oversold",
    "once": false,
    "when": "welfare_sold > 400",
    "label": "秒杀库存超放！亏本配额击穿400单红线",
    "severity": "violation"
   },
   {
    "id": "r_risk_limit",
    "once": false,
    "when": "risk_score >= 50",
    "label": "负面舆情失控！未开拦截盾导致违规分超标被限流",
    "severity": "violation"
   },
   {
    "id": "r_wrong_push",
    "once": true,
    "when": "t > 25 && (prod_select == 1 || prod_select == 3)",
    "label": "洪峰期间高客单价硬推导致极速掉人",
    "severity": "violation"
   },
   {
    "id": "r_premature_rush",
    "once": false,
    "when": "cue_board == 3 && retained_time < 35",
    "label": "停留时长未稳即逼单导致转化率折损",
    "severity": "warning"
   }
  ],
  "scene": {
   "image": "https://jextsfzlbchbnsnxwgeu.supabase.co/storage/v1/object/public/lab-art/mv3z9z8kmvg1-bench.jpg",
   "credit": "底图由通义万相生成",
   "layers": [
